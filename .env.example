# EmailJS public config for the contact form. These are public keys, not secrets.
# Copy to .env for local dev and set the same vars in Vercel (Project Settings > Environment Variables).
# If any is missing, the form is hidden and the email/LinkedIn links remain.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
